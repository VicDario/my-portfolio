---
import { translations, defaultLang, type Lang } from "../i18n/translations";

interface Props {
  lang?: Lang;
}
const { lang = defaultLang } = Astro.props;
const t = translations[lang];
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Lato:ital,wght@0,100;0,300;0,400;0,700;0,900;1,100;1,300;1,400;1,700;1,900&display=swap"
      rel="stylesheet"
    />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={t.meta.description} />
    <title>{t.meta.title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>

<style lang="scss" is:global>
  @use "../vars" as vars;

  html,
  body {
    font-family: "Lato", sans-serif;
    padding: 0;
    margin: 0;
    font-size: 62.5%;
  }

  html {
    scroll-behavior: smooth;
  }

  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }
  }

  body {
    background-color: vars.$bg;
    -webkit-font-smoothing: antialiased;
  }

  ::selection {
    background-color: vars.$green;
    color: vars.$dark;
  }

  :focus-visible {
    outline: 2px solid vars.$green;
    outline-offset: 3px;
    border-radius: 2px;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  * {
    box-sizing: border-box;
  }

  h1 {
    font-size: vars.$font-title-size-primary-mobile;
  }

  h2 {
    font-size: vars.$font-title-size-secondary-mobile;
  }

  h3 {
    font-size: vars.$font-title-size-tertiary-mobile;
    font-weight: 400;
  }

  p,
  a,
  li,
  h1,
  h2,
  h3 {
    color: vars.$white;
  }

  p,
  a,
  li {
    font-size: vars.$font-size-md;
  }

  @media (min-width: 480px) {
    h1 {
      font-size: vars.$font-title-size-primary-tablet;
    }
    h2 {
      font-size: vars.$font-title-size-secondary-tablet;
    }
    h3 {
      font-size: vars.$font-title-size-tertiary-tablet;
    }
  }

  @media (min-width: 768px) {
    h1 {
      font-size: vars.$font-title-size-primary-desktop;
    }
    h2 {
      font-size: vars.$font-title-size-secondary-desktop;
    }
    h3 {
      font-size: vars.$font-title-size-tertiary-desktop;
    }
  }
</style>
