---
import background from "../assets/header_image.png";
import NavBar from "./NavBar.astro";
import ContactButton from "./ContactButton.astro";
import LanguageToggle from "./LanguageToggle.astro";
import { Image } from 'astro:assets';
import { translations, type Lang } from "../i18n/translations";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = translations[lang];
---

<header class="header">
  <Image
    alt="Background"
    src={background}
    class="header-background"
  />
  <div class="lang-slot">
    <LanguageToggle lang={lang} />
  </div>
  <NavBar lang={lang} />
  <div class="content">
    <div class="content-title">
      <h1>Víctor Fernández</h1>
      <h3>{t.hero.role}</h3>
    </div>
    <ContactButton lang={lang} />
  </div>
  <a class="redirect" href="#work">
    <span class="line"></span>
    <span class="redirect-text">{t.hero.viewProjects}</span>
    <span class="redirect-arrow" aria-hidden="true">
      <svg viewBox="0 0 24 24" fill="none">
        <path d="M9 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </span>
  </a>
</header>

<style lang="scss">
  @use "../vars" as vars;

  .header {
    color: vars.$white;
    width: 100%;
    height: 100vh;
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: space-around;
  }

  .lang-slot {
    position: absolute;
    top: 20px;
    right: 20px;
    z-index: 2;
  }

  @media (min-width: 768px) {
    .lang-slot {
      top: 28px;
      right: 40px;
    }
  }

  .header-background {
    position: absolute;
    filter: drop-shadow(0 0 0 #000);
    object-fit: cover;
    border-radius: 0 0 40px 40px;
    z-index: -1;
    object-position: 60% 50%;
    width: 100%;
    height: 100%;
  }

  .content {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding-left: 24px;
    padding-bottom: 150px;
    h1,
    h3 {
      padding-left: 12px;
    }
    h1 {
      border-left: 3px solid vars.$white;
    }
    .content-title {
      padding-bottom: 32px;
    }
  }
  .redirect {
    display: flex;
    justify-content: flex-start;
    align-items: center;
    width: max-content;
    .line {
      width: 60px;
      height: 2px;
      background-color: vars.$white;
      margin-right: 15px;
      transition: width 0.25s ease;
    }
    .redirect-text {
      font-size: vars.$font-size-lg;
    }
    .redirect-arrow {
      display: grid;
      place-items: center;
      width: 33px;
      height: 33px;
      margin-left: 14px;
      border-radius: 50%;
      border: 2px solid vars.$green;
      color: vars.$green;
      transition: background-color 0.25s ease, color 0.25s ease;
      svg {
        width: 16px;
        height: 16px;
      }
    }
    &:hover {
      .line {
        width: 90px;
      }
      .redirect-arrow {
        background-color: vars.$green;
        color: vars.$dark;
      }
    }
  }

  @media (min-width: 768px) {
    .header {
      padding-top: 0;
      .content {
        padding-left: 50px;
      }
    }
  }
</style>
