---
import { translations, type Lang } from "../i18n/translations";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = translations[lang].skills;

const groups = [
  { title: t.languagesTitle, items: t.languages },
  { title: t.technologiesTitle, items: t.technologies },
  { title: t.personalTitle, items: t.personal },
];
---

<section class="abilities" id="about-me">
  <div class="abilities__wrap">
    <span class="eyebrow">{t.eyebrow}</span>
    <div class="abilities__grid">
      {
        groups.map((group) => (
          <article class="abil">
            <h3>{group.title}</h3>
            <ul role="list">
              {group.items.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style lang="scss">
  @use "../vars" as vars;

  .abilities {
    padding: clamp(5rem, 8vh, 9rem) 0;
    border-top: 1px solid vars.$line;
  }

  .abilities__wrap {
    width: min(92%, 108rem);
    margin-inline: auto;
  }

  .eyebrow {
    font-family: vars.$mono;
    font-size: 1.2rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: vars.$green;
  }

  .abilities__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.4rem;
    margin-top: 3.6rem;
  }

  .abil {
    background-color: vars.$surface;
    border: 1px solid vars.$line;
    border-radius: 12px;
    padding: 2.4rem;

    h3 {
      font-family: vars.$mono;
      font-size: 1.3rem;
      font-weight: 700;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: vars.$ink-faint;
      margin: 0 0 1.6rem;
    }

    ul {
      list-style: none;
      margin: 0;
      padding: 0;
      display: grid;
      gap: 1rem;
    }

    li {
      display: flex;
      align-items: center;
      gap: 1rem;
      font-size: 1.6rem;

      &::before {
        content: "";
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background-color: vars.$green;
        flex: none;
      }
    }
  }

  @media (min-width: 720px) {
    .abilities__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
