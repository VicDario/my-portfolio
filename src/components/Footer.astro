---
import { Icon } from "astro-icon/components";
import ContactButton from "./ContactButton.astro";
import CurriculumVitaeButton from "./CurriculumVitaeButton.astro";
import { translations, type Lang } from "../i18n/translations";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = translations[lang];
---

<footer class="outro" id="contacto">
  <div class="outro__wrap">
    <h2>{t.footer.cta}</h2>
    <div class="outro__actions">
      <ContactButton lang={lang} />
      <CurriculumVitaeButton lang={lang} />
    </div>
    <div class="outro__meta">
      <a href="https://github.com/VicDario" target="_blank" rel="noreferrer">
        <Icon name="fa6-brands:github" size="22px" />
        <span>GitHub</span>
      </a>
      <a href="https://www.linkedin.com/in/vicdariof/" target="_blank" rel="noreferrer">
        <Icon name="fa6-brands:linkedin" size="22px" />
        <span>LinkedIn</span>
      </a>
      <span class="outro__sign">Víctor Fernández · {t.hero.role}</span>
    </div>
  </div>
</footer>

<style lang="scss">
  @use "../vars" as vars;

  .outro {
    padding: clamp(6rem, 12vh, 12rem) 0;
    border-top: 1px solid vars.$line;
    text-align: center;
  }

  .outro__wrap {
    width: min(92%, 108rem);
    margin-inline: auto;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  h2 {
    font-size: clamp(2.6rem, 6vw, 4rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.1;
    margin: 0;
    max-width: 18ch;
    text-wrap: balance;
  }

  .outro__actions {
    display: flex;
    gap: 1.4rem;
    justify-content: center;
    flex-wrap: wrap;
    align-items: center;
    margin-top: 3.6rem;
  }

  .outro__meta {
    margin-top: 5.2rem;
    display: flex;
    gap: 2.4rem;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    font-family: vars.$mono;
    font-size: 1.3rem;
    color: vars.$ink-faint;

    a {
      display: inline-flex;
      align-items: center;
      gap: 0.7rem;
      color: vars.$ink-soft;
      transition: color 0.2s ease;

      &:hover {
        color: vars.$green;
      }
    }
  }

  .outro__sign {
    color: vars.$ink-faint;
  }
</style>
