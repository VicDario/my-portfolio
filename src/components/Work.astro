---
import { translations, type Lang } from "../i18n/translations";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = translations[lang].work;
const projects = t.projects;
---

<section class="work" id="work">
  <h2 class="work__title">{t.title}</h2>

  <div class="work__carousel">
    <button class="work__arrow work__arrow--prev" type="button" aria-label={t.prev}>
      <svg viewBox="0 0 24 44" fill="none" aria-hidden="true">
        <path d="M21 3 4 22l17 19" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </button>

    <ul class="work__track" role="list">
      {projects.map((project, i) => (
        <li class="work__card" data-index={i}>
          <article class="work__card-inner">
            <header class="work__card-head">
              <h3 class="work__card-title">{project.title}</h3>
              <p class="work__card-meta">{project.company} · {project.period}</p>
            </header>
            <img
              class="work__card-image"
              src={project.image}
              alt={project.title}
              width="640"
              height="370"
              loading="lazy"
            />
            <ul class="work__card-desc" role="list">
              {project.description.map((line) => <li>{line}</li>)}
            </ul>
            <ul class="work__card-tags" role="list">
              {project.tags.map((tag) => <li>{tag}</li>)}
            </ul>
          </article>
        </li>
      ))}
    </ul>

    <button class="work__arrow work__arrow--next" type="button" aria-label={t.next}>
      <svg viewBox="0 0 24 44" fill="none" aria-hidden="true">
        <path d="M3 3 20 22 3 41" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </button>
  </div>

  <div class="work__dots" role="tablist" aria-label={t.select}>
    {projects.map((project, i) => (
      <button
        class="work__dot"
        type="button"
        role="tab"
        data-index={i}
        aria-label={project.title}
      ></button>
    ))}
  </div>
</section>

<style lang="scss">
  @use "../vars" as vars;

  .work {
    padding: 40px 16px 60px;
    overflow: hidden;

    &__title {
      text-align: center;
      margin: 0 0 32px;
    }

    &__carousel {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 4px;
      max-width: 1200px;
      margin: 0 auto;
    }

    &__track {
      display: flex;
      align-items: center;
      justify-content: center;
      list-style: none;
      margin: 0;
      padding: 0;
      flex: 1;
      min-height: 480px;
    }

    &__card {
      flex: 0 0 auto;
      transition: opacity 0.35s ease, transform 0.35s ease;
      width: min(86vw, 320px);

      &.is-hidden {
        display: none;
      }
      // Mobile: only the active card is visible.
      &.is-prev,
      &.is-next {
        display: none;
      }
    }

    &__card-inner {
      background-color: vars.$gray;
      border-radius: 8px;
      padding: 24px 22px;
      height: 100%;
      display: flex;
      flex-direction: column;
      gap: 14px;
    }

    &__card-head {
      display: flex;
      flex-direction: column;
      gap: 4px;
    }

    &__card-title {
      color: vars.$green;
      font-weight: 700;
      font-size: 2.6rem;
      margin: 0;
    }

    &__card-meta {
      color: rgba(vars.$white, 0.7);
      font-size: vars.$font-size-sm;
      margin: 0;
    }

    &__card-image {
      width: 100%;
      height: auto;
      aspect-ratio: 640 / 370;
      object-fit: cover;
      border-radius: 6px;
      display: block;
    }

    &__card-desc {
      list-style: disc;
      margin: 0;
      padding-left: 18px;
      display: flex;
      flex-direction: column;
      gap: 8px;

      li {
        font-size: vars.$font-size-sm;
        line-height: 1.5;
        color: rgba(vars.$white, 0.9);
      }
    }

    &__card-tags {
      list-style: none;
      margin: auto 0 0;
      padding: 0;
      display: flex;
      flex-wrap: wrap;
      gap: 8px;

      li {
        font-size: 1.1rem;
        padding: 4px 12px;
        border: 1px solid rgba(vars.$green, 0.5);
        border-radius: 20px;
        color: vars.$green;
      }
    }

    &__arrow {
      flex: 0 0 auto;
      background: transparent;
      border: none;
      color: vars.$green;
      cursor: pointer;
      padding: 8px;
      width: 40px;
      display: grid;
      place-items: center;
      transition: transform 0.2s ease, opacity 0.2s ease;
      opacity: 0.8;

      svg {
        width: 18px;
        height: auto;
      }

      &:hover {
        opacity: 1;
        transform: scale(1.15);
      }
    }

    &__dots {
      display: flex;
      justify-content: center;
      gap: 12px;
      margin-top: 28px;
    }

    &__dot {
      width: 10px;
      height: 10px;
      padding: 0;
      border-radius: 50%;
      border: none;
      background-color: rgba(vars.$green, 0.35);
      cursor: pointer;
      transition: background-color 0.2s ease, transform 0.2s ease;

      &[aria-selected="true"] {
        background-color: vars.$green;
        transform: scale(1.25);
      }
    }

    @media (min-width: 768px) {
      padding: 60px 24px 90px;

      &__title {
        margin-bottom: 48px;
      }

      &__carousel {
        gap: 12px;
      }

      &__track {
        min-height: 560px;
        gap: 0;
      }

      &__card {
        width: 300px;

        // On desktop the neighbours flank the active card.
        &.is-prev,
        &.is-next {
          display: block;
          opacity: 0.5;
          transform: scale(0.9);
        }

        &.is-prev {
          margin-right: -28px;
        }
        &.is-next {
          margin-left: -28px;
        }

        &.is-active {
          position: relative;
          z-index: 2;
          width: 340px;
        }
        &.is-prev,
        &.is-next {
          z-index: 1;
        }
      }

      &__card.is-prev .work__card-inner,
      &__card.is-next .work__card-inner {
        background-color: #111110;
      }

      &__card-title {
        font-size: 3rem;
      }

      &__arrow svg {
        width: 22px;
      }

      &__dots {
        display: none;
      }
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>(".work").forEach((root) => {
    const cards = Array.from(root.querySelectorAll<HTMLElement>(".work__card"));
    const dots = Array.from(root.querySelectorAll<HTMLElement>(".work__dot"));
    const prev = root.querySelector<HTMLButtonElement>(".work__arrow--prev");
    const next = root.querySelector<HTMLButtonElement>(".work__arrow--next");
    const total = cards.length;
    if (!total) return;
    let active = 0;

    const render = () => {
      cards.forEach((card, i) => {
        const rel = (i - active + total) % total;
        card.classList.remove("is-active", "is-prev", "is-next", "is-hidden");
        if (rel === 0) {
          card.classList.add("is-active");
          card.style.order = "1";
        } else if (rel === 1) {
          card.classList.add("is-next");
          card.style.order = "2";
        } else if (rel === total - 1) {
          card.classList.add("is-prev");
          card.style.order = "0";
        } else {
          card.classList.add("is-hidden");
          card.style.order = "3";
        }
        card.setAttribute("aria-hidden", rel === 0 ? "false" : "true");
      });
      dots.forEach((dot, i) =>
        dot.setAttribute("aria-selected", i === active ? "true" : "false")
      );
    };

    prev?.addEventListener("click", () => {
      active = (active - 1 + total) % total;
      render();
    });
    next?.addEventListener("click", () => {
      active = (active + 1) % total;
      render();
    });
    dots.forEach((dot, i) =>
      dot.addEventListener("click", () => {
        active = i;
        render();
      })
    );

    render();
  });
</script>
