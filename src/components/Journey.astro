---
import { translations, type Lang, type Project } from "../i18n/translations";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = translations[lang].work;
const projects = t.projects;

/** First 4-digit year in a period string, e.g. "2021 - 2024" -> "2021". */
const startYear = (project: Project) => project.period.match(/\d{4}/)?.[0] ?? "";
const first = projects[0];
---

<section class="journey" id="work">
  <div class="journey__wrap">
    <div class="journey__head">
      <span class="eyebrow">{t.eyebrow}</span>
      <h2>{t.head}</h2>
    </div>

    <div class="journey__grid">
      <aside class="rail" aria-hidden="true">
        <div class="rail__label">{t.railLabel}</div>
        <div class="rail__year" id="railYear">{startYear(first)}</div>
        <div class="rail__place" id="railPlace">{first.company}</div>
        <div class="rail__meter"><i id="railMeter"></i></div>
      </aside>

      <div class="timeline" id="timeline">
        <div class="timeline__spine"><i id="spineFill"></i></div>

        {
          projects.map((project) => (
            <article class="role" data-year={startYear(project)} data-place={project.company}>
              <span class="role__node" />
              <span class="role__period">{project.period}</span>
              <h3 class="role__title">{project.title}</h3>
              <p class="role__org">{project.company}</p>
              <p class="role__lede">{project.lede}</p>
              <div class="role__card">
                <ul class="role__detail" role="list">
                  {project.description.map((line) => (
                    <li>{line}</li>
                  ))}
                </ul>
                <div class="role__tags" role="list">
                  {project.tags.map((tag) => (
                    <span class="tag" role="listitem">
                      {tag}
                    </span>
                  ))}
                </div>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style lang="scss">
  @use "../vars" as vars;

  .journey {
    padding: clamp(4rem, 7vh, 8rem) 0 clamp(5rem, 9vh, 10rem);
  }

  .journey__wrap {
    width: min(92%, 108rem);
    margin-inline: auto;
  }

  .journey__head {
    margin-bottom: clamp(3.6rem, 6vh, 6.4rem);

    h2 {
      font-size: clamp(2.2rem, 4vw, 3rem);
      font-weight: 800;
      letter-spacing: -0.02em;
      margin: 1.4rem 0 0;
      text-wrap: balance;
      max-width: 24ch;
    }
  }

  .eyebrow {
    font-family: vars.$mono;
    font-size: 1.2rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: vars.$green;
  }

  .journey__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0;
  }

  // Sticky rail — desktop only
  .rail {
    display: none;
  }

  // Spine + roles
  .timeline {
    position: relative;
    padding-left: 3.4rem;
  }

  .timeline__spine {
    position: absolute;
    left: 5px;
    top: 8px;
    bottom: 8px;
    width: 2px;
    background-color: vars.$line;
    border-radius: 2px;
    overflow: hidden;

    i {
      position: absolute;
      inset: 0 0 auto 0;
      height: 0;
      background: linear-gradient(vars.$green, vars.$accent-deep);
      box-shadow: 0 0 14px rgba(vars.$green, 0.3);
      transition: height 0.12s linear;
    }
  }

  .role {
    position: relative;
    padding-bottom: clamp(4.6rem, 7vh, 7.6rem);

    &:last-child {
      padding-bottom: 0;
    }
  }

  .role__node {
    position: absolute;
    left: -3.4rem;
    top: 6px;
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background-color: vars.$bg;
    border: 2px solid vars.$ink-faint;
    z-index: 2;
    transition: border-color 0.4s ease, background-color 0.4s ease, box-shadow 0.4s ease,
      transform 0.4s ease;
  }

  .role.is-active .role__node {
    border-color: vars.$green;
    background-color: vars.$green;
    box-shadow: 0 0 0 5px rgba(vars.$green, 0.18), 0 0 18px rgba(vars.$green, 0.3);
    transform: scale(1.15);
  }

  .role__period {
    display: block;
    font-family: vars.$mono;
    font-size: 1.25rem;
    letter-spacing: 0.06em;
    color: vars.$amber;
    margin-bottom: 0.6rem;
  }

  .role__title {
    font-size: clamp(1.8rem, 3.4vw, 2.4rem);
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1.1;
    margin: 0;
    color: vars.$white;
  }

  .role__org {
    font-family: vars.$mono;
    font-size: 1.35rem;
    color: vars.$ink-soft;
    margin: 0.6rem 0 0;
  }

  .role__lede {
    font-size: 1.7rem;
    line-height: 1.55;
    color: vars.$white;
    margin: 1.8rem 0 0;
    max-width: 60ch;
  }

  .role__card {
    margin-top: 2rem;
    background-color: vars.$surface;
    border: 1px solid vars.$line;
    border-radius: 12px;
    padding: clamp(1.8rem, 3vw, 2.6rem);
    transition: border-color 0.4s ease;
  }

  .role.is-active .role__card {
    border-color: rgba(vars.$green, 0.4);
  }

  .role__detail {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1.2rem;

    li {
      position: relative;
      padding-left: 2.2rem;
      font-size: 1.5rem;
      line-height: 1.5;
      color: vars.$ink-soft;

      &::before {
        content: "›";
        position: absolute;
        left: 0.4rem;
        top: -0.1rem;
        color: vars.$green;
        font-weight: 700;
      }
    }
  }

  .role__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
    margin-top: 2.2rem;
    padding-top: 2rem;
    border-top: 1px solid vars.$line;
  }

  .tag {
    font-family: vars.$mono;
    font-size: 1.2rem;
    padding: 0.4rem 1.1rem;
    border-radius: 100px;
    border: 1px solid rgba(vars.$green, 0.4);
    color: vars.$green;
  }

  @media (min-width: 900px) {
    .journey__grid {
      grid-template-columns: 22rem 1fr;
      gap: 4.8rem;
      align-items: start;
    }

    .rail {
      display: block;
      position: sticky;
      top: 9.6rem;
      align-self: start;
    }

    .rail__label {
      font-family: vars.$mono;
      font-size: 1.2rem;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: vars.$ink-faint;
    }

    .rail__year {
      font-family: vars.$mono;
      font-weight: 600;
      font-size: 3.4rem;
      color: vars.$white;
      margin: 1rem 0 0.4rem;
      font-variant-numeric: tabular-nums;
      transition: color 0.4s ease;
    }

    .rail__place {
      font-size: 1.5rem;
      color: vars.$ink-soft;
      min-height: 1.4em;
    }

    .rail__meter {
      margin-top: 2.6rem;
      width: 3px;
      height: 19rem;
      border-radius: 3px;
      background-color: vars.$line;
      position: relative;
      overflow: hidden;

      i {
        position: absolute;
        inset: 0 0 auto 0;
        height: 0;
        background: linear-gradient(vars.$green, vars.$accent-deep);
        transition: height 0.2s linear;
      }
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .timeline__spine i,
    .rail__meter i,
    .role__node,
    .role__card {
      transition: none;
    }
  }
</style>

<script>
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  const timeline = document.getElementById("timeline");

  if (timeline) {
    const roles = Array.from(timeline.querySelectorAll<HTMLElement>(".role"));
    const railYear = document.getElementById("railYear");
    const railPlace = document.getElementById("railPlace");
    const spineFill = document.getElementById("spineFill");
    const railMeter = document.getElementById("railMeter");

    // Light up the role nearest the viewport centre and sync the rail.
    const activeObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          roles.forEach((role) => role.classList.remove("is-active"));
          entry.target.classList.add("is-active");
          const el = entry.target as HTMLElement;
          if (railYear) railYear.textContent = el.dataset.year ?? "";
          if (railPlace) railPlace.textContent = el.dataset.place ?? "";
        });
      },
      { threshold: 0.5, rootMargin: "-20% 0px -30% 0px" }
    );
    roles.forEach((role) => activeObserver.observe(role));

    // Fill the spine (and rail meter) as the timeline scrolls through the viewport.
    const updateFill = () => {
      const rect = timeline.getBoundingClientRect();
      const start = window.innerHeight * 0.5;
      const total = rect.height + start * 0.4;
      const passed = Math.min(Math.max(start - rect.top, 0), total);
      const percent = total > 0 ? Math.round((passed / total) * 100) : 0;
      if (spineFill) spineFill.style.height = percent + "%";
      if (railMeter) railMeter.style.height = percent + "%";
    };

    if (reduce) {
      if (spineFill) spineFill.style.height = "100%";
      if (railMeter) railMeter.style.height = "100%";
    } else {
      let ticking = false;
      const onScroll = () => {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(() => {
          updateFill();
          ticking = false;
        });
      };
      window.addEventListener("scroll", onScroll, { passive: true });
      window.addEventListener("resize", updateFill, { passive: true });
      updateFill();
    }
  }
</script>
